#!/usr/bin/env bash
#
# First run on a new machine: install mise, link its config, and bootstrap.
# 1Password's SSH agent must be working first, since bootstrap clones the other
# repos over SSH. After this, run `mise bootstrap` to apply config changes.

source "$(dirname "$0")/framework.sh"
DOTFILES="$WORKSPACE/repos/dotfiles"

if [ -x "$HOME/.local/bin/mise" ]; then
    info "Mise already installed"
else
    info "Installing Mise"
    curl -fsSL https://mise.run | sh
fi

symlink "$DOTFILES/mise/config.toml" "$HOME/.config/mise/config.toml"

"$HOME/.local/bin/mise" bootstrap

info "Done! Open a new shell to get started."
